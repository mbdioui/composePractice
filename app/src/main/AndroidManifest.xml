<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Application tag: Root element for app configuration
         Contains all app components (activities, services, etc.) -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pictet"
        tools:targetApi="31">

        <!-- MainActivity: Entry point of the application
             android.name=".MainActivity": Refers to MainActivity.kt in default package
             android.exported="true": Allows launcher to start this activity
             This is required for activities with MAIN/LAUNCHER intent filter -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <!-- intent-filter: Declares what intents this activity can handle
                 MAIN action: This is the main entry point of the app
                 LAUNCHER category: Makes activity appear in app launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
