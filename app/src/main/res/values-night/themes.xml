<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme.Pictet: Dark theme variant for the application
         Parent: Theme.Material - Uses system dark theme when device is in dark mode
         Material3 Compose theme (PictetTheme) provides actual Material You colors -->
    <style name="Theme.Pictet" parent="android:Theme.Material.NoActionBar">
        <!-- statusBarColor: Transparent for edge-to-edge display
             Allows content to draw behind status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- navigationBarColor: Transparent for edge-to-edge experience
             System will automatically handle contrast in dark mode -->
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- windowBackground: Background shown before Compose renders
             Using system dark background color -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>
</resources>
