<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme.Pictet: Light theme for the application
         Parent: Theme.Material3.Light.NoActionBar - Material Design 3 without action bar
         We use NoActionBar because Compose handles the top bar (if needed) -->
    <style name="Theme.Pictet" parent="android:Theme.Material.Light.NoActionBar">
        <!-- android:Theme.Material.Light.NoActionBar: Base Android Material light theme
             This provides the foundation - status bar, window background, basic widgets
             Material3 Compose theme provides the actual Material You colors -->

        <!-- statusBarColor: Color of the system status bar at top of screen
             Using transparent lets the app draw behind it (edge-to-edge)
             Actual color controlled by Compose theme -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- navigationBarColor: Color of system navigation bar at bottom
             Also transparent for edge-to-edge experience -->
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- windowBackground: Background color shown before Compose renders
             Using system background color for consistency -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>
</resources>
